// =============================================================================
// Schéma métier — Grossiste Pro (préventes & livraisons)
//
// - Seul le schéma PostgreSQL `public` est géré par Prisma.
// - Supabase Auth (schéma `auth`) reste hors de Prisma : mots de passe, sessions
//   et authentification y restent gérés. public.profiles.id = auth.users.id
//   (la clé étrangère profiles -> auth.users existe réellement dans PostgreSQL
//   et n'est PAS modélisée ici ; ne jamais la supprimer).
// - Règles non exprimables en Prisma (CHECK, RLS, triggers) : voir
//   supabase/migrations/002_business_schema.sql (brouillon, non appliqué).
// - Toute écriture passe par le serveur, qui vérifie le rôle depuis le profil
//   authentifié. Les rôles/permissions ne sont jamais lus depuis le navigateur.
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Unité de vente d'un produit. Les quantités (stock, lignes de commande) sont
/// exprimées dans cette unité : pas de colonne d'unité dupliquée sur les lots.
enum SaleUnit {
  carton
  sachet
  triplette
  pot
  boite
  bouteille
  unite

  @@map("sale_unit")
  @@schema("public")
}

enum OrderStatus {
  brouillon
  en_attente
  assignee
  en_livraison
  livree
  annulee

  @@map("order_status")
  @@schema("public")
}

/// Journée de travail d'un pré-vendeur (migration 006).
enum WorkDayStatus {
  ouverte
  cloturee

  @@map("work_day_status")
  @@schema("public")
}

enum WorkDayCustomerSource {
  planning
  manuel

  @@map("work_day_customer_source")
  @@schema("public")
}

/// « À faire » n'est pas stocké : c'est l'absence de visite pour ce client dans la journée.
enum VisitStatus {
  en_cours
  commandee
  sans_commande
  annulee

  @@map("visit_status")
  @@schema("public")
}

enum NoOrderReason {
  client_absent
  pas_de_besoin
  produit_indisponible

  @@map("no_order_reason")
  @@schema("public")
}

// -----------------------------------------------------------------------------
// Utilisateurs (Supabase Auth reste la source d'authentification)
// -----------------------------------------------------------------------------

/// public.profiles — table existante, colonnes inchangées.
/// `role` reste une chaîne ("admin" | "vendeur" | "livreur") pour ne pas modifier
/// la table existante ; la valeur est validée côté serveur (lib/auth/roles.ts).
model Profile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  role      String   @default("vendeur")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  customersCreated    Customer[]
  customerPhotosAdded CustomerPhoto[]
  ordersCreated       Order[]              @relation("OrderCreatedBy")
  assignmentsAsDriver OrderAssignment[]    @relation("AssignmentDriver")
  assignmentsMade     OrderAssignment[]    @relation("AssignmentAssignedBy")
  statusChanges       OrderStatusHistory[]
  stockAdjustments    StockAdjustment[]
  workDays            WorkDay[]
  visits              Visit[]
  customerSchedules   CustomerSchedule[]

  @@map("profiles")
  @@schema("public")
}

// -----------------------------------------------------------------------------
// Catalogue : produits et parfums/variantes
// -----------------------------------------------------------------------------

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
  @@schema("public")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  categoryId  String?  @map("category_id") @db.Uuid
  saleUnit    SaleUnit @map("sale_unit")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Photo du produit lui-même (migration 004) — utile pour un produit sans parfum.
  imagePublicId   String? @map("image_public_id")
  imageSecureUrl  String? @map("image_secure_url")
  /// Prix de vente catalogue par unité de vente (migration 005). NULL = non défini.
  /// Défaut du produit ; un parfum peut définir le sien (ProductVariant.salePrice).
  salePrice       Decimal? @map("sale_price") @db.Decimal(12, 2)

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variants ProductVariant[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
  @@schema("public")
}

/// Un parfum/variante d'un produit (ex. Biscuit -> Chocolat). Le stock et les
/// lignes de commande se rattachent à la variante, pas au produit parent.
/// Seules les références Cloudinary sont stockées (jamais le fichier).
model ProductVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  name           String
  sku            String?  @unique
  imagePublicId  String?  @map("image_public_id")
  imageSecureUrl String?  @map("image_secure_url")
  /// Prix de vente propre au parfum (migration 005). NULL = utilise celui du produit.
  salePrice      Decimal? @map("sale_price") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stockLots  StockLot[]
  orderItems OrderItem[]

  @@unique([productId, name])
  @@map("product_variants")
  @@schema("public")
}

// -----------------------------------------------------------------------------
// Stock par lot (compatible FEFO)
// -----------------------------------------------------------------------------

/// FEFO : le serveur prélève dans l'ordre expiresAt ASC (NULLS LAST), puis
/// receivedAt ASC, parmi les lots où availableQuantity > 0.
/// Alerte « expire bientôt » : expiresAt <= (aujourd'hui + 3 mois).
/// Les décrémentations se font côté serveur, en transaction.
model StockLot {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  lotNumber         String?   @map("lot_number")
  initialQuantity   Int       @map("initial_quantity")
  availableQuantity Int       @map("available_quantity")
  expiresAt         DateTime? @map("expires_at") @db.Date
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Date
  /// Prix d'achat unitaire de CE lot (migration 005). Un lot = un achat distinct : le prix
  /// d'un nouvel achat crée un nouveau lot, les anciens ne sont pas écrasés.
  /// NULL = inconnu (lots antérieurs à la migration) : jamais remplacé par un coût inventé.
  unitCost          Decimal?  @map("unit_cost") @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  adjustments StockAdjustment[]
  allocations OrderItemAllocation[]

  @@unique([variantId, lotNumber])
  @@index([variantId, expiresAt])
  @@index([expiresAt])
  @@index([variantId, expiresAt], map: "stock_lots_fefo_available_idx", where: raw("(available_quantity > 0)"))
  @@map("stock_lots")
  @@schema("public")
}

// -----------------------------------------------------------------------------
// Clients et photos de boutiques
// -----------------------------------------------------------------------------

model Customer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessName  String   @map("business_name")
  phone         String?
  address       String
  googleMapsUrl String?  @map("google_maps_url")
  notes         String?
  createdById   String   @map("created_by_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy Profile         @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  photos    CustomerPhoto[]
  orders    Order[]
  schedules CustomerSchedule[]
  workDayEntries WorkDayCustomer[]
  visits    Visit[]

  @@index([createdById])
  @@index([businessName])
  @@map("customers")
  @@schema("public")
}

/// Photos privées de la boutique (aide à la reconnaissance par le livreur).
/// Supprimer une ligne ne supprime jamais le client. Le fichier Cloudinary est
/// supprimé par une route serveur sécurisée AVANT de supprimer la ligne.
model CustomerPhoto {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  imageSecureUrl String    @map("image_secure_url")
  imagePublicId  String    @unique @map("image_public_id")
  takenAt        DateTime? @map("taken_at") @db.Timestamptz(6)
  addedById      String    @map("added_by_id") @db.Uuid
  caption        String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  addedBy  Profile  @relation(fields: [addedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([customerId])
  @@index([addedById])
  @@map("customer_photos")
  @@schema("public")
}

// -----------------------------------------------------------------------------
// Commandes, lignes, statuts, affectations
// -----------------------------------------------------------------------------

model Order {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Numéro lisible, utile pour le livreur et les échanges avec le client.
  number      Int         @unique @default(autoincrement())
  customerId  String      @map("customer_id") @db.Uuid
  createdById String      @map("created_by_id") @db.Uuid
  status      OrderStatus @default(brouillon)
  notes       String?
  /// Journée / visite d'origine (migration 006). NULL = commande créée hors module pré-vendeur.
  workDayId   String?     @map("work_day_id") @db.Uuid
  visitId     String?     @map("visit_id") @db.Uuid
  /// Validation par le pré-vendeur. NULL = brouillon de saisie (hors chiffre d'affaires et compteurs).
  confirmedAt DateTime?   @map("confirmed_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  workDay       WorkDay?             @relation(fields: [workDayId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  visit         Visit?               @relation(fields: [visitId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy     Profile              @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  assignments   OrderAssignment[]

  @@index([status])
  @@index([customerId])
  @@index([createdById])
  @@index([createdAt])
  @@index([workDayId])
  @@unique([visitId], map: "orders_one_active_per_visit_key", where: raw("(visit_id IS NOT NULL AND status <> 'annulee')"))
  @@map("orders")
  @@schema("public")
}

model OrderItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  /// Instantané du catalogue au moment de la commande (historique préservé).
  productNameSnapshot String   @map("product_name_snapshot")
  flavorNameSnapshot  String   @map("flavor_name_snapshot")
  saleUnitSnapshot    SaleUnit @map("sale_unit_snapshot")
  quantity            Int
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocations OrderItemAllocation[]

  @@unique([orderId, variantId])
  @@index([variantId])
  @@map("order_items")
  @@schema("public")
}

/// Journal append-only des changements de statut.
model OrderStatusHistory {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String       @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  changedBy Profile @relation(fields: [changedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId, createdAt])
  @@index([changedById])
  @@map("order_status_history")
  @@schema("public")
}

/// Historique des affectations. Affectation courante = unassignedAt IS NULL
/// (au plus une par commande, garanti par l'index unique partiel).
/// Une réaffectation clôture l'ancienne ligne (unassignedAt) puis en crée une
/// nouvelle, dans une même transaction.
model OrderAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  driverId     String    @map("driver_id") @db.Uuid
  assignedById String    @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz(6)

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  driver     Profile @relation("AssignmentDriver", fields: [driverId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedBy Profile @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([orderId], map: "order_assignments_one_active_per_order_key", where: raw("(unassigned_at IS NULL)"))
  @@index([orderId])
  @@index([driverId, unassignedAt])
  @@index([assignedById])
  @@map("order_assignments")
  @@schema("public")
}

// -----------------------------------------------------------------------------
// Traçabilité du stock (migration 003 — PROPOSÉE, non appliquée)
// -----------------------------------------------------------------------------

/// Journal append-only des corrections manuelles d'inventaire d'un lot.
model StockAdjustment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId            String   @map("lot_id") @db.Uuid
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  reason           String
  changedById      String   @map("changed_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lot       StockLot @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  changedBy Profile  @relation(fields: [changedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([lotId, createdAt])
  @@index([changedById])
  @@map("stock_adjustments")
  @@schema("public")
}

/// Quantité prélevée dans un lot pour une ligne de commande (FEFO). Sert à
/// restituer le stock à l'annulation : releasedAt non nul = déjà restitué, ce
/// qui empêche toute double restitution.
model OrderItemAllocation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  lotId       String    @map("lot_id") @db.Uuid
  quantity    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt  DateTime? @map("released_at") @db.Timestamptz(6)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot       StockLot  @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderItemId])
  @@index([lotId])
  @@map("order_item_allocations")
  @@schema("public")
}

// -----------------------------------------------------------------------------
// Module pré-vendeur (migration 006)
// -----------------------------------------------------------------------------

/// Planning hebdomadaire : jour ISO (1 = lundi … 7 = dimanche). Le vendredi (5) est interdit
/// par un CHECK SQL : aucun client n'y est planifié automatiquement. Aucun planning par défaut.
model CustomerSchedule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  vendeurId  String   @map("vendeur_id") @db.Uuid
  weekday    Int      @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vendeur  Profile  @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([customerId, vendeurId, weekday], map: "customer_schedules_unique")
  @@index([vendeurId, weekday])
  @@map("customer_schedules")
  @@schema("public")
}

/// Journée de travail : une seule par pré-vendeur et par date (date d'Algérie).
model WorkDay {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendeurId String        @map("vendeur_id") @db.Uuid
  workDate  DateTime      @map("work_date") @db.Date
  status    WorkDayStatus @default(ouverte)
  startedAt DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  closedAt  DateTime?     @map("closed_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendeur   Profile           @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customers WorkDayCustomer[]
  visits    Visit[]
  orders    Order[]

  @@unique([vendeurId, workDate], map: "work_days_vendeur_date_key")
  @@index([workDate])
  @@map("work_days")
  @@schema("public")
}

/// Clients de la journée. Retrait = removedAt (historique conservé), jamais de suppression.
model WorkDayCustomer {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workDayId  String                @map("work_day_id") @db.Uuid
  customerId String                @map("customer_id") @db.Uuid
  source     WorkDayCustomerSource
  addedAt    DateTime              @default(now()) @map("added_at") @db.Timestamptz(6)
  removedAt  DateTime?             @map("removed_at") @db.Timestamptz(6)

  workDay  WorkDay  @relation(fields: [workDayId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workDayId, customerId], map: "work_day_customers_unique")
  @@index([customerId])
  @@map("work_day_customers")
  @@schema("public")
}

model Visit {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workDayId     String         @map("work_day_id") @db.Uuid
  customerId    String         @map("customer_id") @db.Uuid
  vendeurId     String         @map("vendeur_id") @db.Uuid
  status        VisitStatus    @default(en_cours)
  /// Renseigné si et seulement si status = sans_commande (CHECK SQL).
  noOrderReason NoOrderReason? @map("no_order_reason")
  startedAt     DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?      @map("ended_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workDay  WorkDay  @relation(fields: [workDayId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vendeur  Profile  @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orders   Order[]

  @@unique([workDayId, customerId], map: "visits_work_day_customer_key")
  @@index([vendeurId])
  @@index([customerId])
  @@index([workDayId, status])
  @@map("visits")
  @@schema("public")
}
